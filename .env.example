# Google Apps Script Web App untuk spreadsheet EventKu.
# Hanya dipakai di server: JANGAN beri prefix NEXT_PUBLIC_.
# Kalau kosong, web memakai data lokal (data/events.ts) dan pendaftaran tidak bisa dikirim.
SHEETS_API_URL=
SHEETS_API_TOKEN=

# URL publik web (untuk link absolut di metadata Open Graph), mis. https://eventku.vercel.app
# Di Vercel boleh dikosongkan: otomatis memakai domain produksi (VERCEL_PROJECT_PRODUCTION_URL).
SITE_URL=
